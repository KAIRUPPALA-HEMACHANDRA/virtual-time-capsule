generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lastActiveAt DateTime? @map("last_active_at")

  capsules     Capsule[]
  refreshTokens RefreshToken[]
  
  notifications Notification[]
  contributions Contributor[] @relation("contributions")

  @@map("users")
}

// ============================================
// CAPSULE MODEL
// ============================================
model Capsule {
  id           String        @id @default(uuid())
  title        String
  content      String?
  
  status       CapsuleStatus @default(LOCKED)
  unlockAt     DateTime      @map("unlock_at")
  openedAt     DateTime?     @map("opened_at")
  
  isEncrypted  Boolean       @default(false) @map("is_encrypted")
  isPublic     Boolean       @default(false) @map("is_public")

  contentHash  String?  @map("content_hash")

  shareToken   String?  @unique @map("share_token")

  isAnonymous          Boolean @default(false) @map("is_anonymous")
  selfDestructAfterRead Boolean @default(false) @map("self_destruct_after_read")
  reactions            String?
  
  sentimentScore Float?  @map("sentiment_score")
  sentimentLabel String? @map("sentiment_label")
  
  isGeoLocked  Boolean  @default(false) @map("is_geo_locked")
  latitude     Float?
  longitude    Float?
  geoRadius    Int?     @default(100) @map("geo_radius")

  prerequisiteId String?  @map("prerequisite_id")
  prerequisite   Capsule? @relation("CapsuleChain", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  
  isLegacy         Boolean @default(false) @map("is_legacy")
  legacyDays       Int?    @map("legacy_days")

  nextCapsules   Capsule[] @relation("CapsuleChain")

  creatorId    String        @map("creator_id")
  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // A capsule can have multiple file attachments
  attachments  Attachment[]
  recipients   Recipient[]
  contributors Contributor[]

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("capsules")
}

// ============================================
// ATTACHMENT MODEL
// ============================================
// Stores metadata about uploaded files (images, audio, video, PDF)
// The actual files live in the /uploads folder on disk
model Attachment {
  id           String   @id @default(uuid())
  filename     String   // Unique filename on disk (e.g., "1693000000-a8b3c2d1.jpg")
  originalName String   @map("original_name") // User's original filename
  mimetype     String   // File type (e.g., "image/jpeg")
  size         Int      // File size in bytes
  path         String   // Relative path to the file

  capsuleId    String   @map("capsule_id")
  capsule      Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

model Recipient {
  id          String   @id @default(uuid())
  email       String
  
  capsuleId   String   @map("capsule_id")
  capsule     Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  
  notified    Boolean  @default(false)
  viewedAt    DateTime? @map("viewed_at")
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("recipients")
}


// ============================================
// NOTIFICATION MODEL
// ============================================
model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  
  capsuleId String?  @map("capsule_id")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Contributor {
  id           String   @id @default(uuid())
  
  capsuleId    String   @map("capsule_id")
  capsule      Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  
  userId       String?  @map("user_id")
  user         User?    @relation("contributions", fields: [userId], references: [id], onDelete: SetNull)
  
  email        String
  status       String   @default("pending")
  content      String?
  
  invitedAt    DateTime @default(now()) @map("invited_at")
  joinedAt     DateTime? @map("joined_at")

  @@unique([capsuleId, email])
  @@map("contributors")
}

// ============================================
// REFRESH TOKEN MODEL
// ============================================
model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ============================================
// ENUMS
// ============================================
enum CapsuleStatus {
  LOCKED
  UNLOCKED
  OPENED
}
