generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  capsules     Capsule[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// ============================================
// CAPSULE MODEL
// ============================================
model Capsule {
  id           String        @id @default(uuid())
  title        String
  content      String?
  
  status       CapsuleStatus @default(LOCKED)
  unlockAt     DateTime      @map("unlock_at")
  openedAt     DateTime?     @map("opened_at")
  
  isEncrypted  Boolean       @default(false) @map("is_encrypted")
  isPublic     Boolean       @default(false) @map("is_public")

  contentHash  String?  @map("content_hash")
  
  sentimentScore Float?  @map("sentiment_score")
  sentimentLabel String? @map("sentiment_label")
  
  isGeoLocked  Boolean  @default(false) @map("is_geo_locked")
  latitude     Float?
  longitude    Float?
  geoRadius    Int?     @default(100) @map("geo_radius")

  creatorId    String        @map("creator_id")
  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // A capsule can have multiple file attachments
  attachments  Attachment[]

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("capsules")
}

// ============================================
// ATTACHMENT MODEL
// ============================================
// Stores metadata about uploaded files (images, audio, video, PDF)
// The actual files live in the /uploads folder on disk
model Attachment {
  id           String   @id @default(uuid())
  filename     String   // Unique filename on disk (e.g., "1693000000-a8b3c2d1.jpg")
  originalName String   @map("original_name") // User's original filename
  mimetype     String   // File type (e.g., "image/jpeg")
  size         Int      // File size in bytes
  path         String   // Relative path to the file

  capsuleId    String   @map("capsule_id")
  capsule      Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

// ============================================
// REFRESH TOKEN MODEL
// ============================================
model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ============================================
// ENUMS
// ============================================
enum CapsuleStatus {
  LOCKED
  UNLOCKED
  OPENED
}
