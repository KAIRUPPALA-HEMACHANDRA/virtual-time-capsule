# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/virtual_time_capsule?schema=public"

# JWT Secrets (replace with your own random strings)
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Email (Gmail SMTP - use your Gmail account)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
FROM_EMAIL="your-email@gmail.com"
FROM_NAME="Virtual Time Capsule"

# Redis (for BullMQ - will configure later)
REDIS_HOST="localhost"
REDIS_PORT=6379
